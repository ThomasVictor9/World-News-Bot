# Copy this file to .env for local testing (never commit the real .env)

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
NEWS_API_KEY=your_newsapi_key

# Optional - enables auto-posting breaking news to a chat/channel
AUTO_POST_CHAT_ID=your_channel_or_chat_id
AUTO_POST_COUNTRY=us
AUTO_POST_CATEGORY=general
CRON_SCHEDULE=0 */3 * * *
